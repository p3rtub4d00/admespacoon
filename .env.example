MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/admespacoon
MASTER_PASSWORD=troque-por-uma-senha-forte
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres


# Cobrança SaaS EspaçoOn via Asaas
ASAAS_API_KEY=
ASAAS_ENV=production
ASAAS_WEBHOOK_TOKEN=


# OAuth central Mercado Pago para recebimentos das reservas
# Nunca versione valores reais neste arquivo.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_REDIRECT_URI=https://SEU-MASTER.onrender.com/api/oauth/mercadopago/callback
# Use uma chave aleatória longa e exclusiva para criptografar tokens no banco.
MERCADOPAGO_TOKEN_ENCRYPTION_KEY=

# Segredo gerado em Mercado Pago > Webhooks > Configurar notificações.
MERCADOPAGO_WEBHOOK_SECRET=


# Meta WhatsApp Cloud API / Webhook central do ClubeOn
# WHATSAPP_VERIFY_TOKEN: segredo criado por você para validar o callback na Meta.
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET: segredo do app ClubeOn no Meta for Developers.
WHATSAPP_APP_SECRET=


# Backup lógico automático em banco MongoDB separado
# Recomenda-se usar outro cluster/projeto Atlas para evitar perda conjunta.
BACKUP_MONGODB_URI=
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_HOURS=24

# Origem pública do Master para gerar os links de primeiro acesso.
PUBLIC_BASE_URL=https://SEU-MASTER.onrender.com
